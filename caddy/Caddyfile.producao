# HORMOS-PRODUCAO — modelo renderizado pelo ./configurar-dominio.sh
# HTTPS automático via Let's Encrypt (Caddy emite e renova sozinho).
# Requisitos: DNS dos dois domínios apontando para este servidor e
# portas 80/443 liberadas para a internet.
{
    admin off
    email __ACME_EMAIL__
}
(strip_auth) {
    # Remove headers de identidade vindos do CLIENTE: só o oauth2-proxy pode
    # defini-los, após autenticar no Keycloak. Sem isto, qualquer um poderia
    # enviar "X-Forwarded-Email: admin@..." e se passar por administrador.
    request_header -X-Auth-Request-Email
    request_header -X-Auth-Request-User
    request_header -X-Auth-Request-Preferred-Username
    request_header -X-Auth-Request-Groups
    request_header -X-Auth-Request-Access-Token
    request_header -X-Forwarded-Email
    request_header -X-Forwarded-User
    request_header -X-Forwarded-Groups
    request_header -X-Forwarded-Preferred-Username
    # segredo compartilhado: prova que a requisição veio pelo gateway
    request_header -X-Portal-Secret
    request_header X-Portal-Secret {$PORTAL_SHARED_SECRET}
}
(headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # CSP: o projeto NÃO carrega nada externo, então tudo é travado em 'self'.
        # 'unsafe-inline' é necessário pelos ~1240 style= e 15 handlers inline;
        # ainda assim bloqueia exfiltração (connect/script externos), plugins,
        # sequestro de formulário (form-action) e clickjacking (frame-ancestors).
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
__PORTAL_DOMAIN__ {
    import headers
    import strip_auth
    # A API NÃO atende na porta das pessoas: ela tem a 9443. Separar é o que
    # permite ao pessoal de rede fechar ou limitar a API sem tocar no portal, e
    # sem o Hormos precisar de um Caddy compilado com módulo de terceiro.
    handle /api/v1/* {
        respond "{\"erro\": \"A API v1 atende na porta 9443 desta instalacao.\"}" 404 {
            close
        }
    }
    handle {
        reverse_proxy oauth2-portal:4180
    }
}
__AUTH_DOMAIN__ {
    import headers
    import strip_auth
    reverse_proxy keycloak:8080
}

# ── API v1 — PORTA PRÓPRIA ────────────────────────────────────────────────
# Vai DIRETO ao portal, sem o oauth2-proxy: a API se autentica por
# `Authorization: Bearer <token>` do Keycloak, validado pelo próprio portal
# contra o JWKS. O oauth2-proxy existe para sessão de navegador (cookie), que
# API não tem.
#
# `import strip_auth` é OBRIGATÓRIO, não decoração: remove os headers de
# identidade que o cliente possa enviar — sem isso alguém mandaria
# `X-Forwarded-Email: admin@...` numa porta exposta de propósito — e injeta o
# X-Portal-Secret, sem o qual o portal recusa tudo com 401.
#
# Desligada no painel de Administração, a API responde 404 antes de qualquer
# autenticação: a porta fica aberta e inútil, que é o estado desejado.
__PORTAL_DOMAIN__:9443 {
    import headers
    import strip_auth
    handle /api/v1/* {
        reverse_proxy sgsi-portal:5000
    }
    handle {
        respond "{\"erro\": \"Esta porta atende apenas /api/v1.\"}" 404 {
            close
        }
    }
}
