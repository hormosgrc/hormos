TZ=America/Sao_Paulo
POSTGRES_DB=grc_v2
POSTGRES_USER=sgsi
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_REALM=sgsi
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME
MASTER_EMAIL=admin@sgsi.local
MASTER_PASSWORD=CHANGE_ME
# URL pública do portal e do Keycloak (visível no browser do usuário).
# PADRÃO (1º uso / avaliação / na própria máquina): HTTPS em localhost.
#   Portal → https://localhost   ·   Keycloak → https://localhost:8443
#   Resolve em Windows/Linux/Mac SEM tocar em /etc/hosts. Cookies Secure OK
#   (é HTTPS). http://localhost e http://localhost:8080 caem em https://localhost.
#   Único custo: aceitar o aviso de certificado uma vez (CA interna do Caddy;
#   sem HSTS neste modo, então o "prosseguir" funciona em qualquer navegador).
# PRODUÇÃO (domínio do cliente): NÃO edite na mão — use o assistente na área
#   admin (ou ./configurar-dominio.sh), que emite Let's Encrypt ou aceita o
#   certificado do próprio cliente e liga o HSTS.
KEYCLOAK_PUBLIC_URL=https://localhost:8443
PORTAL_PUBLIC_URL=https://localhost
PORTAL_PUBLIC_DOMAIN=localhost
OAUTH2_WHITELIST_DOMAINS=localhost:8443
# HTTPS ativo → cookies Secure (Keycloak, oauth2-proxy e sessão do Flask)
OAUTH2_COOKIE_SECURE=true

# Chave de assinatura da sessão do portal (gerada pelo generate-secrets.sh).
# Sem ela, o portal usa uma chave efêmera e as sessões caem a cada restart.
# Segredo que prova que a requisição passou pelo gateway (Caddy → oauth2-proxy).
# Bloqueia acesso direto ao Flask por dentro da rede. Gerado automaticamente.
PORTAL_SHARED_SECRET=

FLASK_SECRET_KEY=

# DEV_AUTH_EMAIL: SOMENTE para desenvolvimento local SEM o proxy de login.
# Em produção deve ficar VAZIO — se preenchido, dispensa a autenticação!
DEV_AUTH_EMAIL=

# A verificação de licença usa Ed25519: o appliance carrega apenas a chave
# PÚBLICA em LICENSE_PUBLIC_KEY (ver acima). A privada fica com o fornecedor.

# ── Analista IA: UM modelo, sem escada por RAM ───────────────────────────
# O padrão é qwen3:8b (~5,2 GB) e exige 8 GB livres ao Docker. Abaixo disso o
# install.sh RECUSA a IA e segue sem ela, em vez de instalar um modelo menor:
# o modelo pequeno não entregava "menos IA", entregava o mesmo parecer, pior.
# Houve aqui uma escada (7B/3B/1.5B) e ela foi removida.
# Trocar é por sua conta e risco:
#OLLAMA_MODEL=qwen3:8b
# EMBED_MODEL=nomic-embed-text é leve (~300MB) e independe do LLM.
#EMBED_MODEL=nomic-embed-text
# NÃO existe VISION_MODEL. O modelo de visão foi testado e removido: somava
# 3–5 GB, levava minutos a frio e entregava descrição genérica, de baixo valor
# probatório. Evidência em imagem sem texto legível (catraca, portão, sala-cofre)
# é correlacionada pela DESCRIÇÃO que o usuário informa — determinístico,
# instantâneo e sem custo de RAM.

# Chave PÚBLICA Ed25519 do licenciador — o appliance verifica licenças, não emite.
# Obtenha com: docker exec lic_portal python -c "import chave; print(chave.publica_hex())"
LICENSE_PUBLIC_KEY=
